      "skills": [
        {
          "name": "Basic",
          "desc": "Deals 120% ATK damage to a single target in 2 consecutive hits.",
          "icon": "/Skill/Child Emperor (URplus)/he_100320_ur_plus__basic.png",
          "type": "Basic",
          "cost": 0,
          "verificationStatus": "OWNER_CONFIRMED_2026_11_04",
          "source": "owner"
        },
        {
          "name": "Ultimate",
          "desc": "Deals 5000% [Specialized Direct DMG] to targets in a cross-shaped area (affected only by advanced DMG Reduction), ignoring [Specialized Evasion] and [Non-crit DMG Reduction], and penetrates [Unyielding], [Specialized Unyielding].\n\nReduces the number of [Re-Battle] uses for all enemies by 3 when the skill is released. (Cannot be stacked)",
          "icon": "/Skill/Child Emperor (URplus)/he_100320_ur_plus__ultimate.png",
          "type": "Ultimate",
          "cost": 0
        },
        {
          "name": "Super Ultimate",
          "desc": "Deals 7000% [Specialized Direct DMG] to targets in a cross-shaped area (affected only by advanced DMG Reduction), ignoring [Specialized Evasion] and [Non-crit DMG Reduction], and penetrates [Unyielding], [Specialized Unyielding].\n\nReduces the number of [Re-Battle] uses for all enemies by 4 when the skill is released. (Cannot be stacked)",
          "icon": "/Skill/Child Emperor (URplus)/he_100320_ur_plus__ultimate.png",
          "type": "Ultimate",
          "cost": 0
        },
        {
          "name": "Passive",
          "desc": "At battle start, gains 80% [Specialized Non-Crit DMG Reduction].\n\nGrants all allies permanent immunity to [Energy Reduction] and [Energy Lock] effects upon entering the battlefield.",
          "icon": "/Skill/Child Emperor (URplus)/he_100320_ur_plus__passive.png",
          "type": "Passive",
          "cost": 0
        },
        {
          "name": "Passive — 5★ gold",
          "desc": "At battle start, gains 85% [Specialized Non-Crit DMG Reduction].\n\nGrants all allies permanent immunity to [Energy Reduction] and [Energy Lock] effects upon entering the battlefield.",
          "icon": "/Skill/Child Emperor (URplus)/he_100320_ur_plus__passive.png",
          "type": "Passive",
          "cost": 0
        },
        {
          "name": "Passive — 5★ purple",
          "desc": "At battle start, gains 90% [Specialized Non-Crit DMG Reduction].\n\nGrants all allies permanent immunity to [Energy Reduction] and [Energy Lock] effects upon entering the battlefield.",
          "icon": "/Skill/Child Emperor (URplus)/he_100320_ur_plus__passive.png",
          "type": "Passive",
          "cost": 0
        },
        {
          "name": "Awakened Passive",
          "desc": "Gain 3 [4] energy points per turn. Upon entering the battlefield, grant all allies a permanent 92% [95%] [98%] [True DMG Reduction].",
          "icon": "/Skill/Child Emperor (URplus)/he_100320_ur_plus__awaken1.png",
          "type": "Awakening",
          "cost": 0
        }
      ],
      "effects": [
        {
          "term": "[Ready for Battle]",
          "desc": "Only one of the following effects can be active at a time: resurrection or invincibility. After any character's turn, if they are defeated, they will immediately revive, recovering 100% of their health and continuing the battle (considered as 'Resurrected')."
        }
      ],
