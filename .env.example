# Local development defaults to http://localhost:5180 when this value is omitted.
# Production uses the same Vercel domain, so VITE_API_BASE_URL should be omitted.
VITE_API_BASE_URL=http://localhost:5180

# Vercel Functions + Neon (server-only; never prefix these with VITE_).
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
ADMINAUTH__USERNAME=admin
ADMINAUTH__PASSWORD=replace-with-a-strong-password
ADMINAUTH__JWTSIGNINGKEY=replace-with-at-least-32-random-characters

# Gmail password recovery. Resend requires a verified sender domain in production.
PUBLIC_APP_URL=http://localhost:5173
EMAIL__RESENDAPIKEY=replace-with-resend-api-key
EMAIL__FROM=OPM Wiki <no-reply@your-verified-domain.example>
PASSWORDRESET__TOKENLIFETIMEMINUTES=15

# Public recipient information embedded in bank-transfer VietQR images.
BANKTRANSFER__BANKID=970000
BANKTRANSFER__ACCOUNTNUMBER=replace-with-bank-account-number
BANKTRANSFER__ACCOUNTNAME=REPLACE WITH ACCOUNT HOLDER NAME

# Server-only HMAC secret configured identically in SePay Webhook settings.
# Generate a random value with at least 32 characters. Never prefix it with VITE_.
SEPAY__WEBHOOKSECRET=replace-with-at-least-32-random-characters
